{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2agent.org/schemas/fair-publication-advice.schema.json",
  "title": "Evidence-aware Zenodo publication decision advice",
  "type": "object",
  "required": [
    "guide_version", "repository", "dataset_id", "purpose", "recommended_path",
    "recommendation_is_release_approval", "local_findings_are_narrow_checks",
    "reasoning", "questions", "declared_answers", "embargo_until",
    "local_readiness_findings", "next_actions", "options", "sources",
    "external_action_taken"
  ],
  "properties": {
    "guide_version": {"type": "string"},
    "repository": {"const": "Zenodo"},
    "dataset_id": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["explore", "test", "release"]},
    "recommended_path": {
      "enum": [
        "local_preparation", "sandbox_test", "unpublished_draft",
        "published_restricted", "published_public", "published_embargoed"
      ]
    },
    "recommendation_is_release_approval": {"const": false},
    "local_findings_are_narrow_checks": {"const": true},
    "reasoning": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "question"],
        "properties": {
          "key": {"type": "string"},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "declared_answers": {
      "type": "object",
      "required": [
        "owner_approval", "metadata_public_approved", "files_reviewed",
        "files_public_approved"
      ],
      "properties": {
        "owner_approval": {"type": ["boolean", "null"]},
        "metadata_public_approved": {"type": ["boolean", "null"]},
        "files_reviewed": {"type": ["boolean", "null"]},
        "files_public_approved": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "embargo_until": {"type": ["string", "null"]},
    "local_readiness_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "result", "rationale"],
        "properties": {
          "rule_id": {"type": "string"},
          "result": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "options": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "use_when", "visibility", "fair_implication", "source"],
        "properties": {
          "id": {"type": "string"},
          "use_when": {"type": "string"},
          "visibility": {"type": "string"},
          "fair_implication": {"type": "string"},
          "source": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "sources": {"type": "object"},
    "external_action_taken": {"const": false}
  },
  "additionalProperties": false
}
