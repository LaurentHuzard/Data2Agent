{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data2agent.org/schemas/fair-foundation-assessment.schema.json",
  "title": "GO FAIR Foundation item assessment",
  "type": "object",
  "required": ["framework", "source", "dataset_id", "assessment_scope", "results", "summary", "publication_probe", "publication_binding", "publication_state"],
  "properties": {
    "framework": {"const": "GO FAIR Foundation interpretations"},
    "source": {"const": "https://www.gofair.foundation/interpretations"},
    "dataset_id": {"type": "string", "minLength": 1},
    "assessment_scope": {"type": "string"},
    "publication_probe": {"type": ["object", "null"]},
    "publication_binding": {"type": "boolean"},
    "publication_state": {"enum": ["unspecified", "user_declared_unpublished"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/principleResult"}
    },
    "summary": {
      "type": "object",
      "required": ["total", "pass", "unknown"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 15},
        "pass": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "principleResult": {
      "type": "object",
      "required": ["principle", "source", "question", "result", "rationale", "local_findings", "observed_local_gaps", "required_evidence", "acceptance_criteria", "evidence_plan", "evidence", "recommendations"],
      "properties": {
        "principle": {"enum": ["F1", "F2", "F3", "F4", "A1", "A1.1", "A1.2", "A2", "I1", "I2", "I3", "R1", "R1.1", "R1.2", "R1.3"]},
        "source": {"type": "string", "format": "uri"},
        "question": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "unknown"]},
        "rationale": {"type": "string", "minLength": 1},
        "local_findings": {"type": "array", "items": {"type": "object"}},
        "observed_local_gaps": {"type": "array", "items": {"type": "object"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "evidence_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "recommendations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "pass"}}, "required": ["result"]},
          "then": {"properties": {"evidence_plan": {"items": {"properties": {"status": {"const": "verified"}}}}}}
        }
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["requirement", "evidence_origin", "status", "action"],
      "properties": {
        "requirement": {"type": "string", "minLength": 1},
        "evidence_origin": {"enum": ["local", "live_publication", "external_document", "reviewed_assertion", "validator_report"]},
        "status": {"enum": ["not_verified", "observed_partial", "pending_publication", "verified", "contradicted"]},
        "action": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
